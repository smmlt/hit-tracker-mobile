{
  "expo": {
    "name": "Hit Tracker",
    "slug": "hit-tracker-mobile",
    "version": "1.2.5",
    "scheme": "hit-tracker-mobile",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.auraxa.hittracker"
    },
    "android": {
      "versionCode": 16,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#E32222"
      },
      "package": "com.auraxa.hittracker"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-video",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#E32222",
          "defaultChannel": "default"
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Hit Tracker to choose your profile photo.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-native-logo.png",
          "imageWidth": 172,
          "resizeMode": "contain",
          "backgroundColor": "#F00D22",
          "dark": {
            "image": "./assets/splash-native-logo.png",
            "backgroundColor": "#F00D22"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "66730f2f-78b1-4e76-9521-90409d69dbc4"
      }
    },
    "owner": "auraxa"
  }
}
