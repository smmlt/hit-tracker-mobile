{
  "expo": {
    "name": "Hit Tracker",
    "slug": "hit-tracker-mobile",
    "version": "1.0.2",
    "scheme": "hit-tracker-mobile",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.auraxa.hittracker"
    },
    "android": {
      "versionCode": 4,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#E32222"
      },
      "package": "com.auraxa.hittracker"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-video",
      "expo-web-browser",
      "expo-font",
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Hit Tracker to choose your profile photo.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-brand.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#EE1C27"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "66730f2f-78b1-4e76-9521-90409d69dbc4"
      }
    },
    "owner": "auraxa"
  }
}
